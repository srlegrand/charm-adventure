// Charm Adventure in Tomato Land - gameplay tuning.
// Edit and save while the game runs: changes apply within half a second.
// Units: pixels and seconds. The screen is 540 units tall.
(
    player: (
        width: 26.0,
        height: 66.0,
        max_hp: 5,

        run_speed: 300.0,
        sprint_speed: 440.0,       // hold dash on the ground after a dash
        ground_accel: 4000.0,
        air_accel: 3000.0,

        gravity: 2200.0,
        max_fall_speed: 900.0,
        jump_speed: 760.0,
        jump_cut: 0.45,            // upward speed kept when jump is released early
        coyote_time: 0.08,
        jump_buffer: 0.10,
        air_jumps: 1,
        air_jump_speed: 680.0,

        dash_speed: 760.0,
        dash_time: 0.20,
        dash_cooldown: 0.15,

        wall_slide_speed: 140.0,
        wall_jump_x: 360.0,
        wall_jump_y: 700.0,
        wall_jump_lock: 0.14,      // seconds without steering after a wall jump

        attack_time: 0.07,         // how long the drawn swing takes; the hit itself lands on the first tick
        attack_cooldown: 0.20,
        attack_buffer: 0.15,       // an early press still fires on the first possible tick
        combo_window: 2.5,         // seconds to land the next kill and keep the combo
        kill_refund: 0.05,         // after a kill the next attack is ready this soon
        hitstop_hit: 2,            // ticks (1/60 s) the world freezes on a hit,
        hitstop_kill: 3,           // on a kill,
        hitstop_hurt: 8,           // and when the player is hurt
        // A swing hits everything inside the crescent that is drawn for it: weapon_length plus a little, 72 degrees either side.
        weapon_length: 58.0,
        weapon_thickness: 7.0,     // half-thickness of that line
        shoulder_height: 20.0,     // swing pivot above the body centre
        // Swing arcs in degrees (start, end), facing right: 0 forward, 90 up, -90 down.
        swing_side: (105.0, -35.0),
        swing_up: (160.0, 35.0),
        swing_down: (-15.0, -165.0),
        attack_damage: 5,
        attack_recoil: 160.0,
        pogo_speed: 640.0,         // the bounce when a dive hits something
        dive_speed: 1500.0,        // how fast the mid-air dive attack falls

        invuln_time: 1.1,
        hitstun_time: 0.22,
        knockback_x: 320.0,
        knockback_y: 420.0,
    ),
    // width and height are the whole tomato including legs; leg is the leg length.
    // Only the round body above the legs hits and gets hit.
    enemies: {
        "cherry": (
            width: 30.0, height: 36.0, leg: 6.0, flowers: 3, hp: 5, speed: 70.0,
            contact_damage: 1, knockback: 260.0,
            behaviour: Walker,
            color: (0.95, 0.25, 0.2),
        ),
        "beefsteak": (
            width: 54.0, height: 52.0, leg: 9.0, flowers: 12, hp: 15, speed: 40.0,
            contact_damage: 1, knockback: 120.0,
            behaviour: Walker,
            color: (0.75, 0.12, 0.1),
        ),
        "hopper": (
            width: 34.0, height: 43.0, leg: 7.5, flowers: 5, hp: 5, speed: 170.0,
            contact_damage: 1, knockback: 220.0,
            behaviour: Hopper(jump_speed: 620.0, interval: 1.4),
            color: (1.0, 0.5, 0.15),
        ),
    },
)
